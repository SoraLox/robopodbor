{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "sw.schema.json",
  "title": "SW — Robotics software",
  "type": "object",
  "properties": {
    "schema_ver": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "cat": {
      "const": "SW"
    },
    "cat_name": {
      "type": "string"
    },
    "updated": {
      "type": "string",
      "format": "date"
    },
    "items": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/item"
      }
    }
  },
  "required": [
    "schema_ver",
    "cat",
    "cat_name",
    "updated",
    "items"
  ],
  "additionalProperties": false,
  "$defs": {
    "rng": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "min",
        "max"
      ],
      "properties": {
        "min": {
          "type": [
            "number",
            "null"
          ]
        },
        "max": {
          "type": [
            "number",
            "null"
          ]
        }
      }
    },
    "item": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^SW\\d{4}$",
          "description": "internal robot ID"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "description": "model name as the vendor writes it"
        },
        "aliases": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true,
          "description": "other spellings: Latin / Cyrillic, marketing names"
        },
        "vid": {
          "type": "string",
          "pattern": "^VN\\d{4}$",
          "description": "vendor ID, see vendors.json"
        },
        "origin": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "RU",
            "CN",
            "BY",
            "KR",
            "JP",
            "TW",
            "DE",
            "IT",
            "US",
            "TR",
            null
          ],
          "description": "country of manufacture; codes: country"
        },
        "status": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "OP",
            "PI",
            "RD",
            null
          ],
          "description": "availability status; codes: status"
        },
        "trl": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1,
          "maximum": 9,
          "description": "technology readiness level 1-9"
        },
        "photos": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^SW\\d{4}_\\d{2}\\.(jpg|png|webp)$"
          },
          "description": "photo file names <ID>_<NN>.jpg"
        },
