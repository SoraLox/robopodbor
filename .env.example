# Для локального запуска (docker compose up --build) этот файл НЕ нужен.
# Копируйте его в .env, только если меняете порт или размещаете на сервере.

# Порт сайта на этом компьютере, если 8080 занят.
# WEB_PORT=8090

# ── Размещение на сервере ─────────────────────────────────────────────
# POSTGRES_PASSWORD=change-me
# WEB_ORIGIN=https://robopodbor.example.ru

# С HTTPS: docker compose --profile tls up -d --build
# DOMAIN=robopodbor.example.ru
# nginx слушает только localhost, снаружи доступен лишь Caddy.
# WEB_BIND=127.0.0.1
# TRUST_PROXY_HOPS=2

# Сайт на GitHub Pages, API на этом сервере: WEB_ORIGIN=https://<user>.github.io,
# в репозитории переменная API_URL=https://<DOMAIN>/api.
# CROSS_SITE_COOKIES=true
