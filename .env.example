# Скопируйте в .env рядом с docker-compose.yml и поменяйте значения.
POSTGRES_PASSWORD=change-me
WEB_ORIGIN=https://robopodbor.example.ru

# Только для docker compose --profile tls up
DOMAIN=robopodbor.example.ru
# С TLS nginx слушает только localhost, снаружи доступен лишь Caddy.
WEB_BIND=127.0.0.1
TRUST_PROXY_HOPS=2

# Сайт на GitHub Pages, API на этом сервере: WEB_ORIGIN=https://<user>.github.io,
# в репозитории переменная API_URL=https://<DOMAIN>/api.
# CROSS_SITE_COOKIES=true
